# Sanity CMS (leave the project id empty to keep using the JSON files in src/data)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity publish webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Floating WhatsApp button (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=
